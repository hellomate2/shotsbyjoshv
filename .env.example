# Copy to .env.local for local dev, or set these in Vercel → Settings → Environment Variables.

# === Square (required for Card payments) ===
# Get from Square Developer Dashboard → My Application → Credentials
# Use the *Production* access token for the live site.
SQUARE_ACCESS_TOKEN=

# "production" or "sandbox". Defaults to production if unset.
SQUARE_ENVIRONMENT=production

# REQUIRED for Card payments. Square Developer Dashboard → My Application →
# Locations → copy the Location ID (starts with "L…"). Use the production
# location for the live site.
SQUARE_LOCATION_ID=

# === Square webhooks (optional but recommended) ===
# Dashboard → Webhooks → Add Endpoint:
#   URL: https://shotsbyjoshv.com/api/square/webhook
#   Events: payment.created, payment.updated
# Copy the "Signature Key" here.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Only set if Square calls a different URL than the request's origin
# (e.g. behind a proxy). Usually leave unset.
# SQUARE_WEBHOOK_URL=

# === DataForSEO (optional — for weekly rank-tracking cron) ===
# Login = your account email. Password = "API password" from
# dataforseo.com → Dashboard → API Access. ROTATE the password if it has ever
# been shared in plaintext (screenshots etc.).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# === Vercel Cron protection ===
# Vercel Cron sends this in Authorization header so randos can't trigger the
# rank-snapshot endpoint (which costs ~$0.005 per run). Generate any random
# string and set it both here and in your Vercel project env vars.
CRON_SECRET=

# === Resend (booking notification emails to Josh) ===
# Sign up free at resend.com → API Keys → Create.
# Without these, bookings still work; Josh just won't get the email.
RESEND_API_KEY=
# Defaults to shotsbyjoshv.photography@gmail.com if unset.
BOOKING_TO_EMAIL=
# Until shotsbyjoshv.com is verified in Resend, use "onboarding@resend.dev".
# After verification, switch to e.g. "ShotsByJoshV <bookings@shotsbyjoshv.com>".
BOOKING_FROM=

# === Vercel Blob (booking time-slot persistence) ===
# Auto-provisioned when you create a Blob store via:
#   Vercel → Project → Storage → Create → Blob
# Without it, all time slots stay available (no persistence).
BLOB_READ_WRITE_TOKEN=

# === Public ===
NEXT_PUBLIC_CONTACT_EMAIL=shotsbyjoshv.photography@gmail.com
